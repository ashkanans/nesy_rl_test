ARG CUDA_IMAGE=nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04
FROM ${CUDA_IMAGE} AS base

ARG USERNAME=researcher
ARG UID=1000
ARG GID=1000
ARG INSTALL_JAX=1

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_EXTRA_INDEX_URL=https://download.pytorch.org/whl/cu121 \
    VENV_TORCH=/opt/venv-torch \
    VENV_JAX=/opt/venv-jax

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 python3.10-venv python3.10-dev \
    python3-pip \
    git curl ca-certificates \
    build-essential pkg-config graphviz \
    ffmpeg \
    patchelf libgl1-mesa-dev libosmesa6-dev libglu1-mesa \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -g ${GID} ${USERNAME} && \
    useradd -m -u ${UID} -g ${GID} -s /bin/bash ${USERNAME}

RUN mkdir -p ${VENV_TORCH} ${VENV_JAX} /workspace/nesy_rl /home/${USERNAME}/.cache/pip /home/${USERNAME}/.mujoco && \
    chown -R ${USERNAME}:${USERNAME} ${VENV_TORCH} ${VENV_JAX} /workspace/nesy_rl /home/${USERNAME}/.cache /home/${USERNAME}/.mujoco

WORKDIR /workspace/nesy_rl
USER ${USERNAME}

ENV HOME=/home/${USERNAME} \
    PATH=${VENV_TORCH}/bin:$PATH \
    PIP_CACHE_DIR=/home/${USERNAME}/.cache/pip

RUN python3.10 -m venv ${VENV_TORCH} && \
    python3.10 -m venv ${VENV_JAX}

RUN ${VENV_TORCH}/bin/python -m pip install -U pip setuptools wheel && \
    ${VENV_JAX}/bin/python -m pip install -U pip setuptools wheel

COPY requirements-core.txt ./requirements-core.txt
COPY requirements-env.txt ./requirements-env.txt

RUN ${VENV_TORCH}/bin/python -m pip install -r requirements-core.txt -r requirements-env.txt

# MuJoCo Python bindings (official)
RUN ${VENV_TORCH}/bin/python -m pip install mujoco

# MuJoCo 2.1 for mujoco-py (used by D4RL/IQL)
RUN mkdir -p /home/${USERNAME}/.mujoco && \
    curl -L https://github.com/deepmind/mujoco/releases/download/2.1.0/mujoco210-linux-x86_64.tar.gz \
    | tar -xz -C /home/${USERNAME}/.mujoco

ENV MUJOCO_PY_MUJOCO_PATH=/home/${USERNAME}/.mujoco/mujoco210
ENV LD_LIBRARY_PATH=/home/${USERNAME}/.mujoco/mujoco210/bin:${LD_LIBRARY_PATH:-}
ENV D4RL_SUPPRESS_IMPORT_ERROR=1
ENV MUJOCO_GL=egl

# Preinstall mujoco-py with Cython<3 to avoid build failures
RUN ${VENV_TORCH}/bin/python -m pip install "Cython<3" glfw imageio cffi fasteners lockfile && \
    ${VENV_TORCH}/bin/python -m pip install --no-deps "mujoco-py==2.1.2.14"

# D4RL
RUN ${VENV_TORCH}/bin/python -m pip install "git+https://github.com/Farama-Foundation/d4rl@master#egg=d4rl"

# Optional IQL/JAX stack
COPY implicit_q_learning/requirements.txt ./implicit_q_learning/requirements.txt
RUN if [ "${INSTALL_JAX}" = "1" ]; then \
        ${VENV_JAX}/bin/python -m pip install "jax[cuda12]==0.6.2" && \
        ${VENV_JAX}/bin/python -m pip install "numpy==1.26.4" && \
        ${VENV_JAX}/bin/python -m pip install gym==0.23.1 mujoco && \
        ${VENV_JAX}/bin/python -m pip install "Cython<3" glfw imageio cffi fasteners lockfile && \
        ${VENV_JAX}/bin/python -m pip install --no-deps "mujoco-py==2.1.2.14" && \
        ${VENV_JAX}/bin/python -m pip install "git+https://github.com/Farama-Foundation/d4rl@master#egg=d4rl" && \
        ${VENV_JAX}/bin/python -m pip install --no-build-isolation -r /workspace/nesy_rl/implicit_q_learning/requirements.txt; \
    else \
        echo "Skipping JAX/IQL dependency install (INSTALL_JAX=${INSTALL_JAX})"; \
    fi

USER root
COPY docker/ensure_venvs_entrypoint.sh /usr/local/bin/ensure_venvs_entrypoint.sh
RUN chmod +x /usr/local/bin/ensure_venvs_entrypoint.sh

USER ${USERNAME}
ENV PYTHONPATH=/workspace/nesy_rl:${PYTHONPATH:-}

ENTRYPOINT ["/usr/local/bin/ensure_venvs_entrypoint.sh"]
CMD ["/bin/bash"]

FROM base AS dev

COPY --chown=researcher:researcher requirements-tt.txt ./requirements-tt.txt
COPY --chown=researcher:researcher trajectory-transformer ./trajectory-transformer

RUN ${VENV_TORCH}/bin/python -m pip install -r requirements-tt.txt
